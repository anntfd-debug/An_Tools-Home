<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ungroup Groups"
    Width="760"
    Height="650"
    MinWidth="680"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SOURCE -->
        <GroupBox Grid.Row="0" Header="1. Chọn nguồn Group">
            <StackPanel>
                <RadioButton
                    x:Name="rbSelected"
                    Content="Các Group đã được chọn trước khi chạy tool"
                    Margin="0,0,0,3"
                    Checked="source_changed"/>
                <TextBlock
                    x:Name="txtSelectedInfo"
                    Margin="22,0,0,8"
                    Foreground="DimGray"/>

                <RadioButton
                    x:Name="rbCurrentView"
                    Content="Tìm Group theo tên trong view hiện hành"
                    Margin="0,0,0,3"
                    Checked="source_changed"/>
                <TextBlock
                    x:Name="txtViewInfo"
                    Margin="22,0,0,0"
                    Foreground="DimGray"
                    TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- FILTER -->
        <GroupBox Grid.Row="1" Header="2. Lọc theo tên Group Type">
            <Grid x:Name="pnlFilterControls">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Từ khóa:"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>
                    <TextBox
                        x:Name="tbKeyword"
                        Grid.Column="1"
                        MinHeight="30"
                        VerticalContentAlignment="Center"
                        TextChanged="keyword_changed"/>
                    <Button
                        x:Name="btnRefreshView"
                        Grid.Column="2"
                        Content="Quét lại view"
                        Click="refresh_view_clicked"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                    <RadioButton
                        x:Name="rbContains"
                        Content="Contains - tên có chứa từ khóa"
                        Margin="0,0,18,0"
                        Checked="filter_changed"/>
                    <RadioButton
                        x:Name="rbExact"
                        Content="Exact - trùng chính xác"
                        Margin="0,0,18,0"
                        Checked="filter_changed"/>
                    <CheckBox
                        x:Name="cbCaseSensitive"
                        Content="Phân biệt hoa/thường"
                        Click="filter_changed"/>
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,7,0,0"
                    Foreground="DimGray"
                    TextWrapping="Wrap"
                    Text="Có thể nhập nhiều từ khóa, ngăn cách bằng dấu chấm phẩy (;). Để trống sẽ hiển thị tất cả Group trong view."/>
            </Grid>
        </GroupBox>

        <!-- GROUP TYPE LIST -->
        <GroupBox Grid.Row="2" Header="3. Chọn Group Type cần Ungroup">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,7">
                    <Button Content="Chọn tất cả" Click="select_all_clicked"/>
                    <Button Content="Bỏ chọn tất cả" Click="select_none_clicked"/>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="2"
                    Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spGroupList" Margin="4"/>
                    </ScrollViewer>
                </Border>

                <TextBlock
                    x:Name="txtListSummary"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    FontWeight="SemiBold"/>
            </Grid>
        </GroupBox>

        <!-- OPTIONS -->
        <CheckBox
            x:Name="cbAutoUnpin"
            Grid.Row="3"
            Content="Tự động bỏ Pin trước khi Ungroup"
            Margin="2,0,0,12"/>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                x:Name="btnCancel"
                Content="Hủy"
                MinWidth="90"
                Click="cancel_clicked"/>
            <Button
                x:Name="btnUngroup"
                Content="Ungroup"
                MinWidth="150"
                FontWeight="SemiBold"
                Click="ungroup_clicked"/>
        </StackPanel>
    </Grid>
</Window>
