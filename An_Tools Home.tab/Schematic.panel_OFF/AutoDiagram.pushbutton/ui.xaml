<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoDiagram - Thiết Lập Ký Hiệu Sơ Đồ" Height="450" Width="500"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Khớp hình thiết bị 3D sang Ký hiệu sơ đồ 2D" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="#333333"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White" Padding="10">
            <StackPanel Name="MappingPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="BtnDraw" Content="Vẽ Sơ Đồ" Width="100" Height="30" Margin="0,0,10,0" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Name="BtnCancel" Content="Hủy" Width="80" Height="30" 
                    Background="#E0E0E0" Foreground="#333333" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>