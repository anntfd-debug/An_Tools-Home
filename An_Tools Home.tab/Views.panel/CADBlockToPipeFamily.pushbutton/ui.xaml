<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CAD Block → Pipe Family"
    Width="860"
    Height="790"
    MinWidth="760"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Margin="0,0,0,10"
                BorderThickness="1" BorderBrush="#B8B8B8" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="CAD Block → Family → Pipe" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="cad_summary_text" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1. Vị trí và Family" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Level đặt Family" Margin="0,5,10,5"/>
                        <ComboBox x:Name="level_combo" Grid.Row="0" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vị trí trong CAD block" Margin="0,5,10,5"/>
                        <ComboBox x:Name="placement_combo" Grid.Row="1" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Lọc Family Type" Margin="0,5,10,5"/>
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="family_filter_box" Grid.Column="0" Margin="0,3" MinHeight="26"
                                     ToolTip="Nhập Family name, Type name hoặc Category"/>
                            <TextBlock x:Name="family_count_text" Grid.Column="1" Margin="10,7,0,0"/>
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Family Type" Margin="0,5,10,5"/>
                        <ComboBox x:Name="family_combo" Grid.Row="3" Grid.Column="1" Margin="0,3" MinHeight="28"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. Ánh xạ Parameter" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Family nhận cao độ" Margin="0,5,10,5"/>
                        <ComboBox x:Name="family_elevation_combo" Grid.Row="0" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Family nhận đường kính" Margin="0,5,10,5"/>
                        <ComboBox x:Name="family_diameter_combo" Grid.Row="1" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nguồn cao độ Pipe" Margin="0,5,10,5"/>
                        <ComboBox x:Name="pipe_elevation_combo" Grid.Row="3" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Nguồn đường kính Pipe" Margin="0,5,10,5"/>
                        <ComboBox x:Name="pipe_diameter_combo" Grid.Row="4" Grid.Column="1" Margin="0,3" MinHeight="26"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="3. Raycast, xoay và kiểm tra trùng">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Chiều cao tia +Z (mm)" Margin="0,5,10,5"/>
                        <TextBox x:Name="max_ray_box" Grid.Row="0" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tolerance tìm Pipe XY (mm)" Margin="0,5,10,5"/>
                        <TextBox x:Name="pipe_search_tolerance_box" Grid.Row="1" Grid.Column="1" Margin="0,3" MinHeight="26"
                                 ToolTip="Khoảng lệch bổ sung ngoài bán kính ống khi raycast không bắt được solid. Mặc định 100 mm."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tolerance trùng (mm)" Margin="0,5,10,5"/>
                        <TextBox x:Name="duplicate_tolerance_box" Grid.Row="2" Grid.Column="1" Margin="0,3" MinHeight="26"/>

                        <CheckBox x:Name="align_connector_checkbox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,3"
                                  Content="Xoay Family quanh trục Z để BasisZ của connector song song phương ngang của Pipe"/>
                        <CheckBox x:Name="skip_duplicates_checkbox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,3"
                                  Content="Bỏ qua vị trí đã có cùng Family Type trên Level"/>

                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Tool ưu tiên raycast solid. Nếu raycast không bắt được, tool đối chiếu LocationCurve của Pipe với vùng bao CAD block trên mặt bằng theo tolerance XY. Ống dốc vẫn lấy đúng Z tại station gần vị trí Family; Family chỉ xoay trong mặt bằng."/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,10,0,8" Padding="8" BorderThickness="1"
                BorderBrush="#D0D0D0" CornerRadius="3">
            <TextBlock x:Name="status_text" Text="Chọn cấu hình rồi nhấn Thực hiện." TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="cancel_button" Content="Hủy" Width="100" Height="32" Margin="0,0,8,0"/>
            <Button x:Name="run_button" Content="Thực hiện" Width="120" Height="32" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
