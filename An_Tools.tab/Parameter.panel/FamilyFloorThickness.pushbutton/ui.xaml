<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cập nhật dữ liệu sàn cho Family"
    Width="650"
    Height="820"
    MinWidth="590"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Family -->
        <Border Grid.Row="0" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Family đã chọn" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="txt_family_name" Grid.Column="2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock x:Name="txt_type_count" Grid.Column="3" Foreground="#666666" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Scope -->
        <GroupBox Grid.Row="2" Header="Phạm vi quét Family Instance" Padding="10">
            <StackPanel>
                <RadioButton x:Name="rb_entire_model" Content="Toàn bộ model" Margin="0,2,0,5"/>
                <RadioButton x:Name="rb_active_view" Content="Chỉ các family đang hiển thị trong Active View" Margin="0,2,0,2"/>
            </StackPanel>
        </GroupBox>

        <!-- Types -->
        <GroupBox Grid.Row="4" Header="Family Type cần xử lý" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button x:Name="btn_select_all" Content="Chọn tất cả" MinWidth="100" Padding="10,4" Margin="0,0,8,0"/>
                    <Button x:Name="btn_select_none" Content="Bỏ chọn" MinWidth="90" Padding="10,4"/>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="3" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="panel_types"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Operations -->
        <GroupBox Grid.Row="6" Header="Chức năng cần chạy" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="chk_run_ray" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Ray-cast lên trên để lấy chiều dày Floor"
                          FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Parameter nhận chiều dày" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmb_floor_parameter" Grid.Row="2" Grid.Column="1" MinHeight="27"/>

                <CheckBox x:Name="chk_run_elevation" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="Đọc Elevation from Level hiện có"
                          FontWeight="SemiBold"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Parameter nhận cao độ" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmb_elevation_parameter" Grid.Row="6" Grid.Column="1" MinHeight="27"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                           Foreground="#666666" TextWrapping="Wrap"
                           Text="Có thể chạy riêng từng chức năng hoặc bật cả hai. Khi bật cả hai, hai parameter đích phải khác nhau."/>
            </Grid>
        </GroupBox>

        <!-- Ray settings -->
        <GroupBox x:Name="grp_ray_settings" Grid.Row="8" Header="Cài đặt Ray-cast" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="chk_linked_floors" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Tính cả Floor trong Revit Link đang được load"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lùi điểm bắn tia xuống dưới" VerticalAlignment="Center"/>
                <TextBox x:Name="txt_ray_offset" Grid.Row="2" Grid.Column="1" MinHeight="25" HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Khoảng cách tìm sàn tối đa" VerticalAlignment="Center"/>
                <TextBox x:Name="txt_max_distance" Grid.Row="4" Grid.Column="1" MinHeight="25" HorizontalContentAlignment="Right"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" Margin="8,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                           Foreground="#666666" TextWrapping="Wrap"
                           Text="Tool lấy Floor gần nhất phía trên. Chiều dày ưu tiên tính bằng khoảng cách giữa hai mặt sàn tại đúng tọa độ XY của family."/>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btn_cancel" Grid.Column="1" Content="Hủy" Padding="12,7"/>
            <Button x:Name="btn_run" Grid.Column="3" Content="Chạy" Padding="12,7" FontWeight="SemiBold" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
