<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Split Pipes Pro" Height="540" Width="430" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <GroupBox Header="Chế độ quét ống" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="rb_selection" Content="Quét chọn sau khi nhấn Thực hiện" IsChecked="True" Margin="0,0,20,0"/>
                <RadioButton Name="rb_all" Content="Toàn bộ ống trong Model"/>
            </StackPanel>
        </GroupBox>
        
        <GroupBox Header="Thông số cắt chia tuyến ống" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Chiều dài tiêu chuẩn đoạn ống (mm):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Name="txt_length" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,5"/>
                
                <TextBlock Text="Khoảng cách an toàn cách tường (mm):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Name="txt_wall_offset" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,5"/>

                <CheckBox Name="cb_skip_wall" Content="Bỏ qua tối ưu khoảng cách tường (Cắt từ đầu ống)" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,8,0,0" FontWeight="Bold" Foreground="#FF3333"/>
            </Grid>
        </GroupBox>
        
        <GroupBox Header="Bộ lọc kích thước ống giới hạn (mm)" Grid.Row="2" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Size Min:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="txt_min_size" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock Text="Size Max:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBox Name="txt_max_size" Grid.Column="3" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Chọn File Link Revit để quét Tường phối hợp" Grid.Row="3" Margin="0,0,0,15" Padding="10">
            <ListBox Name="lb_links" Height="100" BorderBrush="#CCCCCC" ScrollViewer.VerticalScrollBarVisibility="Auto">
            </ListBox>
        </GroupBox>
        
        <Button Name="btn_run" Grid.Row="4" Content="Thực hiện chia ống" Height="38" Background="#2196F3" Foreground="White" FontWeight="Bold" Click="btn_run_Click"/>
    </Grid>
</Window>