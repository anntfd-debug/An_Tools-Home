<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Place Group From Linked Families"
        Width="730"
        Height="840"
        MinWidth="680"
        MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ĐẶT MODEL GROUP THEO FAMILY TRONG REVIT LINK"
                       FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="active_view_text"
                       Margin="0,5,0,0"
                       FontWeight="SemiBold"
                       Foreground="#3F6387"/>
            <TextBlock Margin="0,4,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Text="Chỉ quét các Family phù hợp đang hiển thị trong Active View, sau đó đặt Group tại một trong bốn góc cục bộ của Family."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="1. Revit Link đã pick và Group cần đặt" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Các Revit Link đã chọn:"/>
                        <ListBox x:Name="links_list"
                                 Grid.Row="0" Grid.Column="1"
                                 Height="82"
                                 Margin="0,0,0,10"
                                 IsHitTestVisible="False"
                                 Focusable="False"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Margin="0,5,10,10"
                                   Text="Model Group Type:"/>
                        <ComboBox x:Name="group_combo"
                                  Grid.Row="1" Grid.Column="1"
                                  Margin="0,0,0,10"
                                  MinHeight="28"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Margin="0,5,10,8"
                                   Text="Lọc Family / Type:"/>
                        <TextBox x:Name="filter_text"
                                 Grid.Row="2" Grid.Column="1"
                                 Height="115"
                                 MinHeight="90"
                                 Margin="0,0,0,8"
                                 Padding="6"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>

                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="scan_button"
                                    Width="145" Height="30"
                                    Content="Kiểm tra số lượng"/>
                            <TextBlock x:Name="match_count_text"
                                       Margin="12,7,0,0"
                                       Foreground="#555555"
                                       Text="Chưa kiểm tra"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. Chọn góc đặt Group" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Margin="0,0,0,8"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Text="LEFT/RIGHT theo HandOrientation; FRONT/BACK theo FacingOrientation của Family."/>

                        <RadioButton x:Name="left_back_radio"
                                     Grid.Row="1" Grid.Column="0"
                                     Margin="5,5,20,8"
                                     GroupName="AnchorMode"
                                     Content="LEFT_BACK  (Trái - Sau)"/>
                        <RadioButton x:Name="right_back_radio"
                                     Grid.Row="1" Grid.Column="1"
                                     Margin="5,5,0,8"
                                     GroupName="AnchorMode"
                                     Content="RIGHT_BACK  (Phải - Sau)"/>
                        <RadioButton x:Name="left_front_radio"
                                     Grid.Row="2" Grid.Column="0"
                                     Margin="5,5,20,5"
                                     GroupName="AnchorMode"
                                     Content="LEFT_FRONT  (Trái - Trước)"/>
                        <RadioButton x:Name="right_front_radio"
                                     Grid.Row="2" Grid.Column="1"
                                     Margin="5,5,0,5"
                                     GroupName="AnchorMode"
                                     Content="RIGHT_FRONT  (Phải - Trước)"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="3. Khoảng lệch và góc xoay" Margin="0,0,0,12">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="195"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,10,8" Text="Offset ra ngoài theo X (mm):"/>
                        <TextBox x:Name="offset_x_text" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" MinHeight="27" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,5,0,8" Foreground="#777777" Text="X = HandOrientation"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,10,8" Text="Offset ra ngoài theo Y (mm):"/>
                        <TextBox x:Name="offset_y_text" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8" MinHeight="27" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,5,0,8" Foreground="#777777" Text="Y = FacingOrientation"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,10,0" Text="Hiệu chỉnh góc Group (độ):"/>
                        <TextBox x:Name="rotation_offset_text" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" MinHeight="27" VerticalContentAlignment="Center"/>
                        <ComboBox x:Name="rotation_basis_combo" Grid.Row="2" Grid.Column="2" MinHeight="27"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="4. Chạy thử và kiểm soát" Margin="0,0,0,8">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                Padding="9"
                                Background="#FFF5D9"
                                BorderBrush="#E1B84A"
                                BorderThickness="1"
                                CornerRadius="3">
                            <CheckBox x:Name="test_one_checkbox"
                                      FontWeight="SemiBold"
                                      Content="Chỉ tạo 1 Group để kiểm tra góc và vị trí"/>
                        </Border>

                        <CheckBox x:Name="skip_duplicate_checkbox"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  Content="Bỏ qua Group cùng Type đã có gần vị trí đặt"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Margin="24,5,10,8"
                                   Text="Dung sai kiểm tra trùng (mm):"/>
                        <TextBox x:Name="duplicate_tolerance_text"
                                 Grid.Row="2" Grid.Column="1"
                                 Margin="0,0,0,8"
                                 MinHeight="27"
                                 VerticalContentAlignment="Center"/>
                        <CheckBox x:Name="use_solid_checkbox"
                                  Grid.Row="3" Grid.ColumnSpan="2"
                                  Content="Dùng Solid để xác định góc chính xác (khuyến nghị; chậm hơn BoundingBox)"/>
                    </Grid>
                </GroupBox>

                <TextBlock Margin="2,7,2,0"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Text="Mỗi dòng có thể là một từ khóa riêng; cũng có thể ngăn cách bằng dấu chấm phẩy hoặc dấu phẩy. Các từ khóa được hiểu theo điều kiện OR. Để trống sẽ lấy tất cả FamilyInstance đang hiển thị trong Active View. Progress bar có nút Cancel."/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#777777"
                       TextWrapping="Wrap"
                       Text="Cancel lúc đặt Group sẽ hoàn tác toàn bộ lần chạy."/>
            <Button x:Name="cancel_button"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Height="35"
                    Content="Đóng"
                    IsCancel="True"/>
            <Button x:Name="run_button"
                    Grid.Column="2"
                    Height="35"
                    Content="Bắt đầu"
                    IsDefault="True"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
