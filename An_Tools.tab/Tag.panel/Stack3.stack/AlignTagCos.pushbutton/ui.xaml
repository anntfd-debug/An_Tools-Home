<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Leader Alignment Settings" Height="400" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Leader Types" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
            
            <RadioButton x:Name="radAuto" Content="Auto" IsChecked="True" FontWeight="SemiBold"/>
            <TextBlock Text="Select leaders automatically" Foreground="Gray" Margin="20,2,0,10" FontSize="11"/>

            <RadioButton x:Name="radCustomize" Content="Customize" FontWeight="SemiBold"/>
            <TextBlock Text="Select preferred leader types (maximum two leader types can be selected)" Foreground="Gray" Margin="20,2,0,15" FontSize="11"/>

            <WrapPanel Margin="20,0,0,0" IsEnabled="{Binding ElementName=radCustomize, Path=IsChecked}">
                <StackPanel Margin="0,0,20,15">
                    <CheckBox x:Name="chk90UpDown" Content="90° - Up/Down"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,15">
                    <CheckBox x:Name="chk90LeftRight" Content="90° - Left/Right"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,15">
                    <CheckBox x:Name="chk45UpDown" Content="45° - Up/Down"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,15">
                    <CheckBox x:Name="chk45LeftRight" Content="45° - Left/Right"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,15">
                    <CheckBox x:Name="chkStraightUpDown" Content="Straight - Up/Down"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,15">
                    <CheckBox x:Name="chkStraightLeftRight" Content="Straight - Left/Right"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Width="2" Margin="0,0,15,0"/>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Leader Size" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
            
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Min Shoulder length" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox x:Name="txtShoulder" Grid.Row="0" Grid.Column="1" Text="10" Width="50" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Min Elbow length" VerticalAlignment="Center"/>
                <TextBox x:Name="txtElbow" Grid.Row="1" Grid.Column="1" Text="10" Width="50" HorizontalAlignment="Left"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnApply" Content="Apply Configuration" Width="150" Height="30" Click="btnApply_Click"/>
        </StackPanel>
    </Grid>
</Window>